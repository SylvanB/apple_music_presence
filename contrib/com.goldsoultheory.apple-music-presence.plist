<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.goldsoultheory.apple-music-presence</string>

    <key>ProgramArguments</key>
    <array>
        <string>__BINARY__</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart if it ever exits. Discord not being up is not an exit: the
         client retries the socket every 5 seconds, forever. -->
    <key>KeepAlive</key>
    <true/>

    <!-- Tells macOS this is a background service, so it is scheduled and
         throttled accordingly rather than competing with foreground apps. -->
    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>__LOG__</string>
    <key>StandardErrorPath</key>
    <string>__LOG__</string>
</dict>
</plist>
